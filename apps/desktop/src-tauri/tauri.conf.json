{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alfred",
  "version": "0.2.0",
  "identifier": "dev.alfred.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Alfred",
        "url": "/",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
